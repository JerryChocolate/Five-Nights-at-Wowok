[sub_resource type="Shader" id="Shader_fx"]
code = "shader_type canvas_item;
uniform float intensity = 0.0;
float h(vec2 p){ return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
void fragment(){
	float d = distance(UV, vec2(0.5));
	float vig = smoothstep(0.35, 0.95, d);
	float g = h(UV * vec2(1920.0, 1080.0) + vec2(TIME * 37.1, TIME * 91.7));
	float a = vig * (0.52 + 0.38 * intensity) + (g - 0.5) * 0.065;
	vec3 col = mix(vec3(0.0), vec3(0.35, 0.0, 0.0), intensity * vig);
	COLOR = vec4(col, clamp(a, 0.0, 1.0));
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_fx"]
