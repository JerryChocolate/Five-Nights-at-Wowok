[ext_resource type="Script" path="res://scripts/cctv.gd" id="1"]

[sub_resource type="CanvasItemMaterial" id="CanvasItemMaterial_mul"]
blend_mode = 3

[sub_resource type="Shader" id="Shader_cctv"]
code = "shader_type canvas_item;
uniform float burst = 0.0;
float h(vec2 p){ return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }
void fragment(){
	float scan = sin(UV.y * 540.0 * 3.14159) * 0.5 + 0.5;
	float n = h(UV * vec2(640.0, 360.0) + vec2(TIME * 53.0, TIME * 17.0));
	float glitch = step(0.996, h(vec2(floor(UV.y * 40.0), floor(TIME * 8.0))));
	float a = 0.15 + 0.12 * scan + glitch * 0.3;
	vec3 c = vec3(n) * (0.25 + burst * 0.75) + glitch * 0.4;
	COLOR = vec4(c, clamp(mix(a, 1.0, burst), 0.0, 1.0));
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_cctv"]
